# /etc/systemd/system/homelab-host-api.service
# Template: values substituted from .env (and NODE) by setup.py

[Unit]
Description=Homelab Host API Node.js Server
After=network.target

[Service]
User=${PUID}
Group=${PGID}
WorkingDirectory=${PROJECT_ROOT}/dashboard/host-api
ExecStart=${NODE} server.js
Restart=always
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=homelab-api

[Install]
WantedBy=multi-user.target
