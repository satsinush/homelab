# Homelab Environment Variables

# --- Host Machine Configuration ---
TZ='${TZ}'
HOMELAB_IP_ADDRESS='${HOMELAB_IP_ADDRESS}'
PUID='${PUID}'
PGID='${PGID}'
PROJECT_ROOT='${PROJECT_ROOT}'
HOMELAB_LANGUAGE='${HOMELAB_LANGUAGE}'
HOMELAB_LOCALE='${HOMELAB_LOCALE}'

# --- Homelab Project Configuration ---
HOMELAB_HOSTNAME='${HOMELAB_HOSTNAME}'
DNS_DOMAIN='${DNS_DOMAIN}'

# --- Traefik SSL Configuration ---
TRAEFIK_CERT_RESOLVER='${TRAEFIK_CERT_RESOLVER}'
ACME_EMAIL='${ACME_EMAIL}'

# --- Service Names ---
DASHBOARD_SERVICE_NAME='${DASHBOARD_SERVICE_NAME}'
PIHOLE_SERVICE_NAME='${PIHOLE_SERVICE_NAME}'
DOCKHAND_SERVICE_NAME='${DOCKHAND_SERVICE_NAME}'
VAULTWARDEN_SERVICE_NAME='${VAULTWARDEN_SERVICE_NAME}'
GATUS_SERVICE_NAME='${GATUS_SERVICE_NAME}'
GOTIFY_SERVICE_NAME='${GOTIFY_SERVICE_NAME}'
AUTHENTIK_SERVICE_NAME='${AUTHENTIK_SERVICE_NAME}'
DAV_SERVICE_NAME='${DAV_SERVICE_NAME}'
HEADSCALE_SERVICE_NAME='${HEADSCALE_SERVICE_NAME}'
SOGO_SERVICE_NAME='${SOGO_SERVICE_NAME}'

# Headscale MagicDNS base domain (must differ from HEADSCALE_SERVICE_NAME host).
# Default: ts.<DNS_DOMAIN>
HEADSCALE_BASE_DOMAIN='${HEADSCALE_BASE_DOMAIN}'
HEADSCALE_WEB_HOSTNAME='${HEADSCALE_WEB_HOSTNAME}'

# LAN CIDR advertised by the Headscale subnet router (remote clients → LAN).
LAN_SUBNET='${LAN_SUBNET}'

# Docker bridge and reserved Traefik address (derived from the bridge subnet).
DOCKER_SUBNET='${DOCKER_SUBNET}'
TRAEFIK_IP_ADDRESS='${TRAEFIK_IP_ADDRESS}'

# Tailnet client allocation; must be a subnet of 100.64.0.0/10.
HEADSCALE_IPV4_PREFIX='${HEADSCALE_IPV4_PREFIX}'

# Optional: Samba published host port (default 445). Uncomment for Docker Desktop/WSL:
# SAMBA_HOST_PORT=4445

# --- Homelab Dashboard Variables ---
HOMELAB_USERNAME='${HOMELAB_USERNAME}'
HOMELAB_EMAIL='${HOMELAB_EMAIL}'
