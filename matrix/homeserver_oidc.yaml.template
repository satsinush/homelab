# Disable public federation
federation_domain_whitelist: []

# OIDC configuration
oidc_providers:
  - idp_id: authentik
    idp_name: "Login with Authentik"
    discover: true
    issuer: "https://AUTHENTIK_WEB_HOSTNAME/application/o/matrix/"
    client_id: "matrix"
    client_secret: "MATRIX_OIDC_SECRET"
    scopes: ["openid", "profile", "email"]
    user_mapping_provider:
      config:
        localpart_template: "{{ user.preferred_username }}"
        display_name_template: "{{ user.name }}"
