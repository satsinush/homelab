# Paths are relative to the homelab repo root (restic backup cwd).
# Live Postgres data dirs (backed up via pg_dump into */volumes/db-dumps/)
services/authentik/volumes/db/
services/nextcloud/volumes/db/
services/immich/volumes/db/

# Redis caches (safe to lose)
services/authentik/volumes/redis/
services/nextcloud/volumes/redis/
services/unbound/volumes/redis/

# Regenerable ML models / caches
services/immich/volumes/model-cache/

# Exclude only Ollama models until upgrading S3 storage.
services/ollama/volumes/ollama/

*.sock
